\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cablp-macros}[2026/07/06 CABLP manuscript equation macros]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}
\RequirePackage{mathtools}
\RequirePackage{siunitx}
\RequirePackage{xparse}

% General math notation
\providecommand{\dd}{\mathop{}\!\mathrm{d}}
\providecommand{\ee}{\mathrm{e}}
\providecommand{\ii}{\mathrm{i}}
\providecommand{\half}{\frac{1}{2}}
\providecommand{\third}{\frac{1}{3}}
\providecommand{\twothirds}{\frac{2}{3}}
\providecommand{\kB}{k_{\mathrm{B}}}
\providecommand{\qe}{e}
\providecommand{\me}{m_e}
\providecommand{\mp}{m_p}
\providecommand{\mi}{m_i}
\providecommand{\epszero}{\epsilon_0}
\providecommand{\clog}{\ln\Lambda}
\providecommand{\sgv}{\langle\sigma v\rangle}

\DeclareMathOperator{\erf}{erf}
\DeclareMathOperator{\sgn}{sgn}

\NewDocumentCommand{\deriv}{m m}{\frac{\dd #1}{\dd #2}}
\NewDocumentCommand{\pderiv}{m m}{\frac{\partial #1}{\partial #2}}
\NewDocumentCommand{\pderivtwo}{m m}{\frac{\partial^2 #1}{\partial #2^2}}
\NewDocumentCommand{\avg}{m}{\left\langle #1 \right\rangle}
\NewDocumentCommand{\abs}{m}{\left| #1 \right|}
\NewDocumentCommand{\norm}{m}{\left\lVert #1 \right\rVert}
\NewDocumentCommand{\evalat}{m m}{\left. #1 \right|_{#2}}
\NewDocumentCommand{\paren}{m}{\left( #1 \right)}
\NewDocumentCommand{\bracket}{m}{\left[ #1 \right]}
\NewDocumentCommand{\set}{m}{\left\{ #1 \right\}}

% Indices, faces, and finite-volume notation
\NewDocumentCommand{\cell}{m m}{{#1}_{#2}}
\NewDocumentCommand{\face}{m}{{#1+\half}}
\NewDocumentCommand{\leftface}{m}{{#1-\half}}
\NewDocumentCommand{\atcell}{m m}{{#1}_{#2}}
\NewDocumentCommand{\atface}{m m}{{#1}_{#2+\half}}
\NewDocumentCommand{\diff}{m m}{\Delta #1_{#2}}
\NewDocumentCommand{\vol}{m}{V_{#1}}
\NewDocumentCommand{\area}{m}{A_{#1}}

